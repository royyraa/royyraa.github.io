---
import Layout from '@/layouts/Layout.astro'
import { social, profile } from '@/settings'
---
<Layout title="Contact | Rajarshi Roy">
  <section class="contact-hero">
    <p>CONTACT</p>
    <h1>Let’s talk science.</h1>
    <div>I’m happy to discuss research collaborations, molecular simulation, enhanced sampling, structural biology, and scientific software.</div>
  </section>

  <section class="contact-grid">
    <a href={`mailto:${social.email}`}><span>EMAIL</span><strong>{social.email}</strong><small>Start a conversation →</small></a>
    <div><span>CURRENT AFFILIATION</span><strong>{profile.institute}</strong><small>West Lafayette, Indiana, USA</small></div>
    <a href={social.scholar} target="_blank"><span>RESEARCH PROFILE</span><strong>Google Scholar</strong><small>Publications & citations ↗</small></a>
    <a href={social.orcid} target="_blank"><span>RESEARCHER ID</span><strong>ORCID</strong><small>Academic record ↗</small></a>
    <a href={social.github} target="_blank"><span>CODE</span><strong>GitHub</strong><small>Software & repositories ↗</small></a>
    <a href={social.linkedin} target="_blank"><span>NETWORK</span><strong>LinkedIn</strong><small>Professional profile ↗</small></a>
  </section>
</Layout>
<style>.contact-hero{padding:10rem 0 7rem;max-width:900px}.contact-hero>p{font-size:.72rem;letter-spacing:.22em;font-weight:800;opacity:.5}.contact-hero h1{font-size:clamp(4rem,9vw,8rem);line-height:.9;letter-spacing:-.06em;font-weight:900;margin:1rem 0 2.5rem}.contact-hero>div{font-size:1.25rem;line-height:1.75;opacity:.62;max-width:680px}.contact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;padding-bottom:8rem}.contact-grid>a,.contact-grid>div{min-height:12rem;padding:2rem;border:1px solid color-mix(in oklab,currentColor 11%,transparent);border-radius:1.4rem;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}.contact-grid>a:hover{transform:translateY(-4px);border-color:color-mix(in oklab,currentColor 28%,transparent)}.contact-grid span{font-size:.68rem;letter-spacing:.18em;font-weight:800;opacity:.4}.contact-grid strong{font-size:1.45rem;margin-top:auto}.contact-grid small{opacity:.48;margin-top:.5rem}@media(max-width:700px){.contact-hero{padding:7rem 0 5rem}.contact-grid{grid-template-columns:1fr}}</style>
