---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---
<BaseLayout title="Page not found" description="The requested page could not be found.">
  <main class="inner-page" id="main-content">
    <SiteHeader inner />
    <section class="inner-hero error-hero"><div class="inner-orbits" aria-hidden="true"><i></i><b></b><em></em></div><div class="section-shell inner-hero-content"><p class="eyebrow"><span></span> Error 404</p><h1>Lost in the conformational landscape.</h1><p>The page you requested does not exist or has moved.</p><a class="button-primary" href="/">Return home <span>→</span></a></div></section>
  </main>
</BaseLayout>
