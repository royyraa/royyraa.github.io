---
import Layout from '@/layouts/Layout.astro'
import { publications } from '@/data/cv'
import { highlightAuthor } from '@/lib/utils'

const grouped = publications.reduce((acc, paper) => {
  const year = paper.time
  if (!acc[year]) acc[year] = []
  acc[year].push(paper)
  return acc
}, {} as Record<string, typeof publications>)
const years = Object.keys(grouped).sort((a,b)=>Number(b)-Number(a))
---
<Layout title="Publications | Rajarshi Roy">
  <section class="pub-hero">
    <p>PUBLICATIONS</p>
    <h1>Research across molecular dynamics, structural biology, and computational biophysics.</h1>
    <div class="pub-meta"><strong>{publications.length}</strong><span>records currently listed on this site</span></div>
  </section>

  <section class="pub-years">
    {years.map((year)=>(
      <div class="year-block">
        <div class="year-label"><span>{year}</span><small>{grouped[year].length} papers</small></div>
        <div class="year-papers">
          {grouped[year].map((paper)=>(
            <article>
              <h2><a href={paper.link} target="_blank" rel="noopener noreferrer">{paper.title}</a></h2>
              <p class="authors"><span set:html={highlightAuthor(paper.authors)} /></p>
              <div class="pub-foot"><em>{paper.journal}</em><a href={paper.link} target="_blank" rel="noopener noreferrer">DOI ↗</a></div>
              {paper.abstract && <details><summary>Abstract</summary><p>{paper.abstract}</p></details>}
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
<style>.pub-hero{padding:9rem 0 7rem;max-width:1000px}.pub-hero>p{font-size:.72rem;letter-spacing:.22em;font-weight:800;opacity:.5}.pub-hero h1{font-size:clamp(3rem,6.5vw,6.2rem);line-height:.98;letter-spacing:-.05em;font-weight:900;margin:1rem 0 3rem;max-width:14ch}.pub-meta{display:flex;align-items:baseline;gap:1rem}.pub-meta strong{font-size:3rem}.pub-meta span{opacity:.5}.pub-years{padding-bottom:8rem}.year-block{display:grid;grid-template-columns:11rem 1fr;gap:3rem;padding:3rem 0;border-top:1px solid color-mix(in oklab,currentColor 12%,transparent)}.year-label{position:sticky;top:7rem;align-self:start;display:flex;flex-direction:column}.year-label span{font-size:2.4rem;font-weight:900;letter-spacing:-.04em}.year-label small{opacity:.4;margin-top:.4rem}.year-papers article{padding:0 0 2.5rem;margin-bottom:2.5rem;border-bottom:1px solid color-mix(in oklab,currentColor 9%,transparent)}.year-papers article:last-child{border-bottom:0}.year-papers h2{font-size:1.55rem;line-height:1.25;font-weight:800;letter-spacing:-.015em}.authors{font-size:.94rem;line-height:1.65;opacity:.58;margin-top:.9rem}.pub-foot{display:flex;justify-content:space-between;gap:1rem;margin-top:1rem;font-size:.88rem}.pub-foot em{opacity:.48}.pub-foot a{font-weight:700}.year-papers details{margin-top:1.1rem;font-size:.9rem}.year-papers summary{cursor:pointer;font-weight:700;opacity:.55}.year-papers details p{line-height:1.7;opacity:.58;margin-top:.8rem}@media(max-width:750px){.pub-hero{padding:6rem 0 4rem}.year-block{grid-template-columns:1fr;gap:1.5rem}.year-label{position:static;flex-direction:row;align-items:baseline;gap:1rem}}</style>
