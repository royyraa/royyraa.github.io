---
import Layout from '@/layouts/Layout.astro'
import { experiences, education, skills, publications } from '@/data/cv'
---
<Layout title="CV | Rajarshi Roy">
  <section class="cv-hero">
    <p>CURRICULUM VITAE</p>
    <h1>Academic training, research experience, and technical expertise.</h1>
    <div class="cv-actions"><a class="btn btn-secondary rounded-full" href="/files/Rajarshi_Roy_CV.pdf" download>Download CV</a><a class="btn btn-ghost rounded-full" href="/papers">All publications →</a></div>
  </section>

  <section class="cv-section"><div class="cv-label">APPOINTMENTS</div><div>{experiences.map((item)=><article><span>{item.time}</span><h2>{item.title}</h2><p>{item.company} · {item.location}</p></article>)}</div></section>
  <section class="cv-section"><div class="cv-label">EDUCATION</div><div>{education.map((item)=><article><span>{item.time}</span><h2>{item.degree}</h2><p>{item.school} · {item.location}</p></article>)}</div></section>
  <section class="cv-section"><div class="cv-label">TECHNICAL EXPERTISE</div><div class="skills-grid">{skills.map((item)=><article><h2>{item.title}</h2><p>{item.description}</p></article>)}</div></section>
  <section class="cv-section"><div class="cv-label">RECENT PUBLICATIONS</div><div>{publications.slice(0,4).map((paper)=><article><span>{paper.time}</span><h2><a href={paper.link} target="_blank">{paper.title}</a></h2><p>{paper.journal}</p></article>)}</div></section>
</Layout>
<style>.cv-hero{padding:9rem 0 7rem;max-width:950px}.cv-hero>p,.cv-label{font-size:.72rem;letter-spacing:.22em;font-weight:800;opacity:.48}.cv-hero h1{font-size:clamp(3rem,6.5vw,6rem);line-height:.98;letter-spacing:-.05em;font-weight:900;margin:1rem 0 2.5rem}.cv-actions{display:flex;gap:.75rem;flex-wrap:wrap}.cv-section{display:grid;grid-template-columns:14rem 1fr;gap:3rem;padding:4rem 0;border-top:1px solid color-mix(in oklab,currentColor 12%,transparent)}.cv-section article{padding:0 0 2.5rem;margin-bottom:2.5rem;border-bottom:1px solid color-mix(in oklab,currentColor 9%,transparent)}.cv-section article:last-child{border-bottom:0}.cv-section span{font-size:.78rem;opacity:.42;font-weight:700}.cv-section h2{font-size:1.55rem;font-weight:800;line-height:1.2;margin:.5rem 0}.cv-section p{opacity:.58;line-height:1.6}.skills-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.skills-grid article{border:1px solid color-mix(in oklab,currentColor 10%,transparent);border-radius:1.2rem;padding:1.5rem;margin:0}.skills-grid h2{font-size:1.1rem}.skills-grid p{font-size:.93rem;margin-top:1rem}@media(max-width:800px){.cv-hero{padding:6rem 0 4rem}.cv-section{grid-template-columns:1fr;gap:2rem}.skills-grid{grid-template-columns:1fr}}</style>
