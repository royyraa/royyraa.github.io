---
import { ClientRouter } from 'astro:transitions';
import DarkLightController from '../components/ui/DarkLightController.astro'
import Head from '../components/Head.astro'
import { seo, template } from '../settings'
import Footer from '../components/ui/Footer.astro'

type Props = { title?: string; description?: string; image?: string }
const { title = seo.default_title, description = seo.default_description, image = seo.default_image } = Astro.props
const nav = [
  ['Research','/research'],['Publications','/papers'],['Software','/software'],['Service','/service'],['CV','/cv'],['Contact','/contact']
]
---
<!doctype html>
<html lang="en">
  <head>{template.transitions && <ClientRouter />}<Head title={title} description={description} image={image} /></head>
  <body class="bg-base-100 text-base-content">
    <header class="site-header">
      <a class="brand" href={`${template.base}/`}>Rajarshi Roy</a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        {nav.map(([label,href]) => <a href={`${template.base}${href}`}>{label}</a>)}
      </nav>
      <div class="header-actions"><DarkLightController/><button id="menu-toggle" class="menu-toggle" aria-label="Open navigation">☰</button></div>
    </header>
    <div id="mobile-menu" class="mobile-menu">
      {nav.map(([label,href]) => <a href={`${template.base}${href}`}>{label}</a>)}
    </div>
    <main class="site-main"><slot /></main>
    <div class="footer-wrap"><Footer /></div>
  </body>
</html>
<script is:inline>
  const toggle=document.getElementById('menu-toggle'); const menu=document.getElementById('mobile-menu');
  toggle?.addEventListener('click',()=>menu?.classList.toggle('open'));
</script>
<style is:global>
  html{scroll-behavior:smooth}body{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.site-header{position:sticky;top:0;z-index:80;height:4.5rem;padding:0 max(1.25rem,calc((100vw - 1180px)/2));display:flex;align-items:center;gap:2rem;background:color-mix(in oklab,var(--fallback-b1,white) 82%,transparent);backdrop-filter:blur(18px);border-bottom:1px solid color-mix(in oklab,currentColor 9%,transparent)}.brand{font-size:1rem;font-weight:900;letter-spacing:-.02em;margin-right:auto}.desktop-nav{display:flex;gap:1.65rem}.desktop-nav a{font-size:.82rem;font-weight:650;opacity:.62;transition:opacity .2s}.desktop-nav a:hover{opacity:1}.header-actions{display:flex;align-items:center;gap:.5rem}.menu-toggle{display:none;font-size:1.25rem;padding:.5rem}.site-main{width:min(1180px,calc(100% - 2.5rem));margin:0 auto}.footer-wrap{width:min(1180px,calc(100% - 2.5rem));margin:0 auto}.mobile-menu{display:none}
  @media(max-width:800px){.desktop-nav{display:none}.menu-toggle{display:block}.mobile-menu{position:fixed;z-index:79;top:4.5rem;left:0;right:0;padding:1rem 1.5rem 1.5rem;background:color-mix(in oklab,var(--fallback-b1,white) 94%,transparent);backdrop-filter:blur(18px);border-bottom:1px solid color-mix(in oklab,currentColor 9%,transparent);flex-direction:column;gap:.4rem}.mobile-menu.open{display:flex}.mobile-menu a{padding:.8rem;font-weight:700}.site-main,.footer-wrap{width:min(100% - 1.5rem,1180px)}}
</style>
